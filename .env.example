# ---- Application ----
ENVIRONMENT=development
DEBUG=true
BASE_URL=http://localhost:8000
# The customer-facing frontend. Email links point here, with single-use tokens
# in the URL fragment (never sent to a server): {FRONTEND_BASE_URL}/verify-email#token=...
FRONTEND_BASE_URL=http://localhost:3000
APP_VERSION=0.1.0
# Set by CI/deploy to the built commit SHA; left as "unknown" in local dev
GIT_COMMIT_SHA=unknown

# ---- Database ----
POSTGRES_USER=bekaa3d
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=bekaa3d
DATABASE_URL=postgresql+asyncpg://bekaa3d:change_me_in_production@postgres:5432/bekaa3d

# ---- Redis (queue, scheduler locks, rate limits, cache) ----
REDIS_URL=redis://redis:6379/0

# ---- Security ----
JWT_SIGNING_KEY=generate_with__openssl_rand_hex_32
CSRF_SECRET=generate_with__openssl_rand_hex_32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Pepper of the keyed IP hash (ADR-028); the rotate_ip_salt job rotates the DB salt monthly.
# Never reuse across environments. Changing it needs a restart.
IP_HASH_SALT=generate_with__openssl_rand_hex_16
# Encrypts stored admin TOTP secrets. Losing it locks every administrator out
# of MFA and forces re-enrollment; leaking it exposes every stored secret.
MFA_SECRET_KEY=generate_with__openssl_rand_hex_32
MFA_ISSUER=Bekaa3D

# ---- Storage (STL masters must NEVER be web-served) ----
STORAGE_ROOT=/data
STL_PRIVATE_DIR=/data/stl_private
UPLOADS_PRIVATE_DIR=/data/uploads_private
MEDIA_PUBLIC_DIR=/data/media_public
MEDIA_PUBLIC_URL=/media

# nginx internal location used for X-Accel-Redirect (see design Part 2 6.3)
XACCEL_PREFIX=/protected

# Malware scanning (VS-014): `clamav` everywhere real; `fake` is refused outside test/development.
SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Payments ----
# `mock` (development, test, staging) or `none` (no online payment: checkout is 503).
# Production accepts only `none` until a real provider is built (ADR-032 go-live gate).
PAYMENT_PROVIDER=mock
# Signs mock webhooks. Leave unset in development; staging must set its own long random value.
# MOCK_WEBHOOK_SECRET=
WHISH_BASE_URL=
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBHOOK_IPS=
# Set true only once Whish confirms a signature mechanism exists
WHISH_VERIFY_SIGNATURE=false

# ---- Email ----
EMAIL_PROVIDER=console
EMAIL_PROVIDER_KEY=
EMAIL_FROM=no-reply@example.com

# ---- Captcha ----
# `fake` accepts only Cloudflare's dummy token and is refused outside test and development.
CAPTCHA_PROVIDER=fake
TURNSTILE_SECRET=

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=INFO
