# Copy this file to .env.local (git-ignored) and set it to your local
# backend's real address. FVS-001-IMPLEMENTATION-PLAN.md §12: this is the
# only environment variable FVS-001 needs, read server-side only by
# next.config.ts's rewrites() — never NEXT_PUBLIC_-prefixed, since the
# browser never needs to know the backend's real origin. It only ever calls
# the same-origin /api/... path.
API_PROXY_TARGET=http://localhost:8000

# Development only: the backend API does not serve /media/* locally
# (BACKEND-RESPONSE.md B4). Run a static server over the backend checkout's
# storage/media_public folder, e.g. from the backend root:
#   npx serve storage/media_public -l 8001
# and point this at it. Ignored by production builds.
# MEDIA_PROXY_TARGET=http://localhost:8001

# Cloudflare Turnstile PUBLIC site key (public by design). When unset,
# development/test builds fall back to Cloudflare's always-pass test key
# 1x00000000000000000000AA, which issues the dummy token the backend's
# CAPTCHA_PROVIDER=fake accepts. Production requires a real key; the
# Turnstile SECRET belongs to the backend only and never goes here.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
