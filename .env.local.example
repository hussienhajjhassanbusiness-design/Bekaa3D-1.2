# Copy this file to .env.local (git-ignored) and set it to your local
# backend's real address. FVS-001-IMPLEMENTATION-PLAN.md §12: this is the
# only environment variable FVS-001 needs, read server-side only by
# next.config.ts's rewrites() — never NEXT_PUBLIC_-prefixed, since the
# browser never needs to know the backend's real origin. It only ever calls
# the same-origin /api/... path.
API_PROXY_TARGET=http://localhost:8000
